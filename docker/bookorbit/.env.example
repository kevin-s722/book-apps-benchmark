# Bookorbit load test environment
# Copy this file to .env and fill in the values.

# Database
DATABASE_URL=postgres://bookorbit:loadtest_password@postgres:5432/bookorbit
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=loadtest_password
POSTGRES_DB=bookorbit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# App
PORT=3000
NODE_ENV=production

# Auth
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin setup token - used once during first-run setup
SETUP_BOOTSTRAP_TOKEN=CHANGE_ME

# URLs
APP_URL=http://localhost:6061
CLIENT_URL=http://localhost:6061

# Storage
APP_DATA_PATH=/data
PUID=1000
PGID=1000
